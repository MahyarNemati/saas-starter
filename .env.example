# Copy to .env.local for development.

# Required -----------------------------------------------------------------
DATABASE_URL="postgres://saas:saas@localhost:5432/saas"
# At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-characters!!"

# Optional ----------------------------------------------------------------
APP_URL="http://localhost:3000"
DATABASE_POOL_MAX="10"
LOG_LEVEL="info"

# Sign-in providers. At least one is required when NODE_ENV=production.
# AUTH_GITHUB_ID and AUTH_GITHUB_SECRET must be set together.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_RESEND_KEY=""
EMAIL_FROM="SaaS Starter <no-reply@localhost>"
# Without a Resend key, magic-link emails are written here instead of sent.
DEV_MAIL_OUTBOX=".dev-outbox.json"

# Billing. STRIPE_WEBHOOK_SECRET is required whenever STRIPE_SECRET_KEY is set.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_ENTERPRISE="price_..."

# "postgres" (durable, shared across instances) or "memory" (per-process).
RATE_LIMIT_BACKEND="postgres"

# Tests only: pointing this at a reachable server enables the database-backed
# suites, which create and drop a throwaway database per run. Unset, they skip.
# TEST_DATABASE_URL="postgres://saas:saas@localhost:5432/postgres"
